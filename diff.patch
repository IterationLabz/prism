+async function performWebSearch(query: string, tavilyKey?: string): Promise<string> {
+  if (tavilyKey && tavilyKey.trim()) {
+    try {
+      const response = await fetch('https://api.tavily.com/search', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
